{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",

    "repositories": [
        {
            "type": "vcs",

            "url": "https://github.com/ladybirdweb/clockwork.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/ladybirdweb/laravel-gravatar.git"
        }
    ],

    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "bacon/bacon-qr-code": "^3.0.3",
        "bugsnag/bugsnag-laravel": "^2.29.0",
        "doctrine/dbal": "^4.4.1",
        "guzzlehttp/guzzle": "^7.10",
        "itsgoingd/clockwork": "dev-master",
        "laravel/framework": "^12.0",
        "laravel/helpers": "^1.8.2",
        "laravel/passport": "^12.4.2",
        "laravel/pulse": "^1.4.7",
        "laravel/tinker": "^2.10.2",
        "laravel/ui": "^4.6.1",
        "lcobucci/jwt": "^5.6",
        "league/flysystem-aws-s3-v3": "^3.30.1",
        "pragmarx/google2fa": "^9.0",
        "pragmarx/google2fa-laravel": "^2.3.0",
        "spatie/laravel-html": "^3.12.3",
        "thomaswelton/laravel-gravatar": "dev-master"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.16.3",
        "beyondcode/laravel-query-detector": "^2.1.0",
        "cyclonedx/cyclonedx-php-composer": "^6.0",
        "fakerphp/faker": "^1.24.1",
        "laravel/dusk": "^8.3.4",
        "laravel/pint": "^1.26.0",
        "laravel/sail": "^1.51.0",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.8.3",
        "phpunit/phpunit": "^11.5.50",
        "spatie/laravel-ignition": "^2.9.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helper/helpers.php",
            "app/Helper/Callbacks_helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "cyclonedx/cyclonedx-php-composer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
