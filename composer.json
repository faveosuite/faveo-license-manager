{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",

    "repositories": [
        {
            "type": "vcs",

            "url": "https://github.com/ladybirdweb/clockwork.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/ladybirdweb/laravel-gravatar.git"
        }
    ],

    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "bugsnag/bugsnag-laravel": "^2.26",
        "doctrine/dbal": "^3.7",
        "guzzlehttp/guzzle": "^7.2",
        "itsgoingd/clockwork": "dev-master",
        "laravel/framework": "^10",
        "laravel/helpers": "^1.6",
        "laravel/passport": "^11",
        "laravel/tinker": "^2.7",
        "laravel/ui": "^4.2.3",
        "laravelcollective/html": "^6.4",
        "lcobucci/jwt": "^5.2",
        "league/flysystem-aws-s3-v3": "^3.21",
        "pragmarx/google2fa": "^8.0",
        "pragmarx/google2fa-laravel": "^2.2",
        "thomaswelton/laravel-gravatar": "dev-master"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.9",
        "beyondcode/laravel-query-detector": "^1.8",
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.4",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^6.1",
        "phpunit/phpunit": "^9.5.10",
        "spatie/laravel-ignition": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helper/helpers.php",
            "app/Helper/Callbacks_helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
