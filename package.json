        "jquery": "^3.2",
        "lodash": "^4.17.19",
        "popper.js": "^1.12",
        "postcss": "^8.2.13",
        "resolve-url-loader": "^2.3.1",
        "sass": "^1.20.1",
        "sass-loader": "^8.0.0",
        "vue": "^2.5.17",
        "vue-jest": "^3.0.7",
        "vue-loader": "^15.9.5",
        "vue-router": "^3.5.3",
        "vue-template-compiler": "^2.6.10",
